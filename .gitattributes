# Line ending normalization — prevents phantom diffs when IDE accesses
# WSL2 filesystem via \\wsl$\ UNC paths (Kiro + open-remote-wsl)

# Shell scripts: always LF
*.sh text eol=lf

# Text files: normalize to LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.rb text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Binary files: never normalize
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.pdf binary
*.woff2 binary
*.woff binary
*.ttf binary
*.eot binary
